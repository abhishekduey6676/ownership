# These values are safe to expose; RLS provides authorization, not key secrecy.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Server-only: never prefix the Gemini key with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Live analysis is local-development-only until public release safeguards are complete.
# Shared counters use the existing signed-in client; no service-role secret is needed.
# Database setup and verification: docs/engineering/analysis-usage-limits.md.
